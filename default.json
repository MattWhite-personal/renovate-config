{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "timezone": "Europe/London",
  "assignees": [
    "MattWhite-personal"
  ],
  "vulnerabilityAlerts": {
    "labels": ["security"],
    "automerge": false,
    "schedule": ["at any time"],
    "minimumReleaseAge": "0 days"
  },
  "osvVulnerabilityAlerts": true,
  "dependencyDashboardOSVVulnerabilitySummary": "all",
  "semanticCommits": "enabled",
  "semanticCommitType": "chore",
  "semanticCommitScope": "deps",
  "prConcurrentLimit": 10,
  "prHourlyLimit": 7,
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 4am on monday"]
  },
  "packageRules": [
    {
      "description": "Cooling-off: wait 3 days for patch releases",
      "matchUpdateTypes": ["patch"],
      "minimumReleaseAge": "3 days",
      "semanticCommitType": "fix"
    },
    {
      "description": "Cooling-off: wait 7 days for minor releases",
      "matchUpdateTypes": ["minor"],
      "minimumReleaseAge": "7 days",
      "semanticCommitType": "feat"
    },
    {
      "description": "Cooling-off: wait 30 days for major releases",
      "matchUpdateTypes": ["major"],
      "minimumReleaseAge": "30 days",
      "semanticCommitType": "feat"
    },
    {
      "description": "Group the entire Astro ecosystem together across ALL update types (fixes PR #397 scenario)",
      "matchManagers": ["npm"],
      "matchPackageNames": ["astro"],
      "matchPackagePatterns": [
        "^@astrojs/",
        "^@mdx-js/",
        "^remark-",
        "^rehype-",
        "^shiki$"
      ],
      "groupName": "astro ecosystem",
      "groupSlug": "astro-ecosystem"
    },
    {
      "description": "Astro ecosystem majors still require manual approval, but bundled as one PR",
      "matchManagers": ["npm"],
      "matchPackageNames": ["astro"],
      "matchPackagePatterns": [
        "^@astrojs/",
        "^@mdx-js/"
      ],
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true,
      "labels": ["dependencies", "astro", "major"]
    },
    {
      "description": "Fallback: group any other npm patch/minor together",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["patch","minor"],
      "groupName": "npm dependencies"
    },
    {
      "description": "Require manual approval - other npm major updates",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Group Terraform Updates",
      "matchManagers": ["terraform"],
      "groupName": "Terraform AzureRM provider",
      "matchUpdateTypes": ["patch","minor"]
    },
    {
      "description": "Require manual approval - Terraform Major Updates",
      "matchManagers": ["terraform"],
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Group GitHub Actions",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["patch","minor"],
      "groupName": "Github Actions"
    },
    {
      "description": "Require manual Approval - Github Actions Major Updates",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Pin Github Actions to commit SHA",
      "matchManagers": ["github-actions"],
      "pinDigests": true
    },
    {
      "description": "Fast PR creation for frequently-majored actions, still needs approval",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["major"],
      "matchPackageNames": [
        "actions/github-script"
      ],
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "Pin npm packages exactly (matches your package.json style)",
      "matchDatasources": ["npm"],
      "rangeStrategy": "pin"
    }
  ]
}
